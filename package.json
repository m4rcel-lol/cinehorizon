{
  "name": "cinehorizon",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @cinehorizon/db db:generate",
    "db:push": "pnpm --filter @cinehorizon/db db:push",
    "db:seed": "pnpm --filter @cinehorizon/db db:seed"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "concurrently": "8.2.2",
    "typescript": "5.5.4"
  }
}
