# Database
DB_PASSWORD=changeme_db
DATABASE_URL=postgresql://cinehorizon:changeme_db@localhost:5432/cinehorizon

# Redis
REDIS_URL=redis://localhost:6379

# JWT - generate with:
# openssl genrsa -out keys/private.pem 4096
# openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Local media storage
MEDIA_PUBLIC_URL=http://localhost:47304/media
LOCAL_MEDIA_DIR=./media

# Transactional email (verification + password reset)
# EMAIL_TRANSPORT: "smtp" to send, "console" to log instead (default: smtp when
# SMTP_HOST is set, otherwise console). SMTP works with Amazon SES, Postmark,
# Mailgun, Gmail, etc. For Amazon SES, create SMTP credentials and use e.g.:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_PORT=587
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
APP_NAME=CineHorizon
EMAIL_FROM=CineHorizon <noreply@cinehorizon.local>

# App
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:47304
WEB_ORIGIN=http://localhost:47304
ADMIN_ORIGIN=http://localhost:47304/admin
CORS_ORIGINS=
COOKIE_DOMAIN=
ADMIN_SEED_EMAIL=admin@cinehorizon.local
ADMIN_SEED_PASSWORD=ChangeMe123!
