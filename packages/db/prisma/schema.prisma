generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  displayName    String
  avatarUrl      String?
  role           Role      @default(USER)
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  profiles       Profile[]
  sessions       Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  @@index([role])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Profile {
  id           String         @id @default(cuid())
  userId       String
  name         String
  avatarIndex  Int            @default(0)
  isKids       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist    Watchlist[]
  watchHistory WatchHistory[]
  savedDownloads SavedDownload[]
  @@unique([userId, name])
  @@index([userId])
}

model Content {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  type             ContentType
  releaseYear      Int
  ageRating        String
  durationMinutes  Int?
  backdropUrl      String
  posterUrl        String
  logoUrl          String?
  trailerUrl       String?
  isFeatured       Boolean       @default(false)
  isOriginal       Boolean       @default(false)
  isTrending       Boolean       @default(false)
  isTopTen         Boolean       @default(false)
  topTenRank       Int?
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  genres           Genre[]       @relation("ContentGenres")
  cast             CastMember[]
  seasons          Season[]
  videos           Video[]
  watchlist        Watchlist[]
  watchHistory     WatchHistory[]
  maturityTags     String[]
  uploadJobs       UploadJob[]
  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([isFeatured])
  @@index([isTopTen])
  @@index([isTrending])
  @@index([createdAt])
}

model Genre {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  content  Content[] @relation("ContentGenres")
}

model CastMember {
  id            String  @id @default(cuid())
  contentId     String
  name          String
  role          String
  characterName String?
  content       Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  @@index([contentId])
}

model Season {
  id        String    @id @default(cuid())
  contentId String
  number    Int
  title     String?
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes  Episode[]
  @@unique([contentId, number])
  @@index([contentId])
}

model Episode {
  id              String   @id @default(cuid())
  seasonId        String
  number          Int
  title           String
  description     String
  durationMinutes Int
  thumbnailUrl    String
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videos          Video[]
  watchHistory    WatchHistory[]
  uploadJobs      UploadJob[]
  @@unique([seasonId, number])
  @@index([seasonId])
}

model Video {
  id          String       @id @default(cuid())
  contentId   String?
  episodeId   String?
  quality     VideoQuality
  url         String
  storageKey  String?
  size        BigInt
  mimeType    String
  status      VideoStatus  @default(PROCESSING)
  uploadedAt  DateTime     @default(now())
  content     Content?     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode     Episode?     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  uploadJobs  UploadJob[]
  @@index([contentId])
  @@index([episodeId])
  @@index([status])
}

model Watchlist {
  profileId String
  contentId String
  addedAt   DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  @@id([profileId, contentId])
  @@index([contentId])
}

model SavedDownload {
  profileId  String
  downloadId String
  savedAt    DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  @@id([profileId, downloadId])
  @@index([downloadId])
}

model WatchHistory {
  id              String   @id @default(cuid())
  key             String   @unique
  profileId       String
  contentId       String
  episodeId       String?
  progressSeconds Int      @default(0)
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content         Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  @@index([profileId])
  @@index([contentId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model UploadJob {
  id        String      @id @default(cuid())
  contentId String?
  episodeId String?
  videoId   String?
  fileName  String
  status    VideoStatus @default(PENDING)
  progress  Int         @default(0)
  message   String?
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  content   Content?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode   Episode?    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  video     Video?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  @@index([status])
  @@index([contentId])
  @@index([episodeId])
}

model Download {
  id            String           @id @default(cuid())
  category      DownloadCategory
  title         String
  slug          String
  description   String
  platform      Platform         @default(WINDOWS)
  version       String?
  developer     String?
  genre         String?
  coverImageUrl String
  fileName      String
  fileUrl       String
  storageKey    String
  fileSize      BigInt
  downloadCount Int              @default(0)
  isPublished   Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  isTrending    Boolean          @default(false)
  isTopRanked   Boolean          @default(false)
  rank          Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  savedBy       SavedDownload[]
  @@unique([category, slug])
  @@index([category, isPublished, createdAt])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([isTopRanked, rank])
  @@index([downloadCount])
  @@index([createdAt])
}

enum DownloadCategory {
  GAME
  SOFTWARE
}

enum Platform {
  WINDOWS
  MAC
  LINUX
  ANDROID
  IOS
  WEB
  MULTI
}

enum Role {
  USER
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
}

enum ContentStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

enum VideoQuality {
  SD_480
  HD_720
  FHD_1080
  UHD_4K
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}
