# Public edge for the Render deployment. envsubst fills ${PORT} (Render assigns
# it), ${API_HOST} and ${API_PORT} (the private api service) at container start.
# Single origin: web at /, admin at /admin, api + media proxied to the api.
events {}
http {
  include /etc/nginx/mime.types;
  sendfile on;
  gzip on;
  gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

  server {
    listen ${PORT};
    client_max_body_size 5G;
    absolute_redirect off;

    location /api/ {
      proxy_pass http://${API_HOST}:${API_PORT};
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 300s;
    }

    # Media is on the api service's persistent disk, served by express.static.
    location /media/ {
      proxy_pass http://${API_HOST}:${API_PORT};
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Admin SPA (built into this image).
    location /admin {
      alias /usr/share/nginx/html/admin;
      try_files $uri $uri/ /admin/index.html;
    }

    # Web SPA (built into this image).
    location / {
      root /usr/share/nginx/html;
      try_files $uri $uri/ /index.html;
    }
  }
}
